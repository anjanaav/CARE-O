rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USERS
    // ============================================================
    match /users/{userId} {

      // A user can manage their own profile.
      allow read, update, delete: if request.auth != null
        && request.auth.uid == userId;

      // A user can create their own profile.
      allow create: if request.auth != null
        && request.auth.uid == userId;

      // A Guardian can read Senior profiles.
      allow get: if request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'guardian'
        && resource.data.role == 'senior';


      // ==========================================================
      // MEDICATION REMINDERS
      // ==========================================================
      match /medication_reminders/{reminderId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // MEDICATION INTAKE
      // ==========================================================
      match /medication_intake/{intakeId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // GUARDIANS
      // ==========================================================
      match /guardians/{guardianId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // NOTIFICATION QUEUE
      // ==========================================================
      match /notification_queue/{queueItemId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // CONNECTED GUARDIANS
      // ==========================================================
      match /connected_guardians/{guardianId} {

        // The Senior who owns this collection can manage
        // their connected Guardians.
        allow read, write: if request.auth != null
          && request.auth.uid == userId;

        // A Guardian can read their own connection document.
        allow read: if request.auth != null
          && request.auth.uid == guardianId;

        // A Guardian can delete their own connection document.
        // Required when the Guardian disconnects from a Senior.
        allow delete: if request.auth != null
          && request.auth.uid == guardianId;

        // A Guardian can create their own connection document
        // when connecting to a Senior using a valid code.
        allow create: if request.auth != null
          && request.auth.uid == guardianId
          && request.resource.data.guardianUid == request.auth.uid
          && request.resource.data.status == 'connected'
          && request.resource.data.connectionCode is string
          && get(
            /databases/$(database)/documents/guardian_connection_codes/$(request.resource.data.connectionCode)
          ).data.seniorUid == userId
          && get(
            /databases/$(database)/documents/guardian_connection_codes/$(request.resource.data.connectionCode)
          ).data.used == false
          && get(
            /databases/$(database)/documents/guardian_connection_codes/$(request.resource.data.connectionCode)
          ).data.expiresAt > request.time;
      }


      // ==========================================================
      // CONNECTED SENIORS
      // ==========================================================
      match /connected_seniors/{seniorId} {

        // The Guardian who owns this collection can manage
        // their connected Seniors.
        allow read, write: if request.auth != null
          && request.auth.uid == userId;

        // The connected Senior can read their own relationship.
        allow read: if request.auth != null
          && request.auth.uid == seniorId;

        // The connected Senior can delete their own relationship.
        // Required when a Senior disconnects from a Guardian.
        allow delete: if request.auth != null
          && request.auth.uid == seniorId;
      }
    }


    // ============================================================
    // GUARDIAN CONNECTION CODES
    // ============================================================
    match /guardian_connection_codes/{code} {

      // Authenticated users can retrieve a specific code.
      allow get: if request.auth != null;

      // A Senior can create their own connection code.
      allow create: if request.auth != null
        && request.resource.data.seniorUid == request.auth.uid
        && request.resource.data.used == false;

      // The Senior who created the code can update/delete it.
      allow update, delete: if request.auth != null
        && resource.data.seniorUid == request.auth.uid;

      // A Guardian can mark an unused code as used.
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.seniorUid == resource.data.seniorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.seniorUid is string
        && resource.data.expiresAt > request.time;

      // Prevent collection-wide listing of connection codes.
      allow list: if false;
    }


    // ============================================================
    // BREATHING SESSIONS
    // ============================================================
    match /breathing_sessions/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}