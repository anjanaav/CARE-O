rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own document under /users/{uid}
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;

      // Medication reminders, nested under the owning user.
      match /medication_reminders/{reminderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Medication intake history, nested under the owning user.
      match /medication_intake/{intakeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Guardian / trusted contact entries, nested under the owning user.
      match /guardians/{guardianId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Queued outbound notifications (e.g. "missed medication" alerts
      // destined for Family & Care Circle members). A future Cloud
      // Function, running with admin privileges, is what actually
      // delivers these — see lib/features/notifications/README.md. The
      // app itself only ever reads/writes its own queue.
      match /notification_queue/{queueItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Breathing streak doc, one per user, doc id == uid (existing structure).
    match /breathing_sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
